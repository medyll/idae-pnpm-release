{
  "name": "@medyll/idae-pnpm-release",
  "version": "1.0.49",
  "description": "Minimalist monorepo release tool for pnpm workspaces",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "idae-pnpm-release": "bin/cli.js"
  },
  "files": [
    "src",
    "bin",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/cli.js",
    "release": "node bin/cli.js",
    "test": "mocha \"test/**/*.js\" --experimental-vm-modules",
    "check-types": "tsc --noEmit"
  },
  "keywords": [
    "pnpm",
    "monorepo",
    "release",
    "versioning",
    "changelog"
  ],
  "author": "Mydde",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@pnpm/find-workspace-packages": "^6.0.9",
    "commander": "^14.0.3",
    "conventional-commits-parser": "^6.4.0",
    "execa": "^9.6.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "@types/semver": "^7.8.0",
    "mocha": "^11.8.0",
    "sinon": "^21.1.2",
    "typescript": "^5.9.3"
  }
}
